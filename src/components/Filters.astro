---
const {years=[],categories=[]}=Astro.props;
---
<div class="filters"><input type="search" aria-label="Inhalte durchsuchen" placeholder="Titel oder Stichwort suchen …" data-search/><select aria-label="Jahr auswählen" data-year><option value="">Alle Jahre</option>{years.map((y:string)=><option value={y}>{y}</option>)}</select>{categories.length>0&&<select aria-label="Kategorie auswählen" data-category><option value="">Alle Kategorien</option>{categories.map((c:string)=><option value={c}>{c}</option>)}</select>}</div><p data-empty hidden>Keine passenden Einträge gefunden.</p>
<script>const search=document.querySelector<HTMLInputElement>('[data-search]');const year=document.querySelector<HTMLSelectElement>('[data-year]');const category=document.querySelector<HTMLSelectElement>('[data-category]');function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-filter-item]').forEach(item=>{const visible=(!search?.value||item.textContent?.toLocaleLowerCase('de').includes(search.value.toLocaleLowerCase('de')))&&(!year?.value||item.dataset.year===year.value)&&(!category?.value||(JSON.parse(item.dataset.categories||'[]') as string[]).includes(category.value));item.hidden=!visible;if(visible)count++;});const empty=document.querySelector<HTMLElement>('[data-empty]');if(empty)empty.hidden=count>0;}search?.addEventListener('input',filter);year?.addEventListener('change',filter);category?.addEventListener('change',filter);</script>
