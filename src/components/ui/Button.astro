---
import type { HTMLAttributes } from 'astro/types';

type CommonProps = { variant?: 'primary' | 'secondary'; tone?: 'indigo' | 'clay' };
type Props = CommonProps & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: never })
);

const { variant = 'primary', tone = 'indigo', class: className, ...attributes } = Astro.props;
const base = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border px-4 py-2 text-center text-sm font-semibold no-underline focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 motion-safe:transition-colors';
const variants = {
  primary: tone === 'clay'
    ? 'border-transparent bg-orange-700 text-white hover:bg-orange-800 hover:text-white focus-visible:outline-orange-600'
    : 'border-transparent bg-indigo-600 text-white hover:bg-indigo-700 hover:text-white focus-visible:outline-indigo-600',
  secondary: 'focus-visible:outline-indigo-600 border-slate-200 bg-white text-slate-900 hover:border-indigo-600 hover:text-indigo-700',
};
const classes = [base, variants[variant], className];
---

{typeof attributes.href === 'string' ? (
  <a {...attributes} class:list={classes}><slot /></a>
) : (
  <button type="button" {...attributes} class:list={classes}><slot /></button>
)}
