---
import type { HTMLAttributes } from 'astro/types';

type CommonProps = { variant?: 'primary' | 'secondary' };
type Props = CommonProps & (
  | (HTMLAttributes<'a'> & { href: string })
  | (HTMLAttributes<'button'> & { href?: never })
);

const { variant = 'primary', class: className, ...attributes } = Astro.props;
const base = 'inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border px-4 py-2 text-center text-sm font-semibold no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:cursor-not-allowed disabled:opacity-50';
const variants = {
  primary: 'border-transparent bg-indigo-600 text-white hover:bg-indigo-700 hover:text-white',
  secondary: 'border-slate-200 bg-white text-slate-900 hover:border-indigo-600 hover:text-indigo-700',
};
const classes = [base, variants[variant], className];
---

{typeof attributes.href === 'string' ? (
  <a {...attributes} class:list={classes}><slot /></a>
) : (
  <button type="button" {...attributes} class:list={classes}><slot /></button>
)}
