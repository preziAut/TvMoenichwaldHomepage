---
import { ArrowDown, ArrowUpRight, Camera, Grid2X2, UserRound } from 'lucide-astro';
import Button from '../ui/Button.astro';

const quickLinks = [
  { title: 'Unsere Tennisplätze', detail: 'Mönichwald & Waldbach', href: '/reservierung/', Icon: Grid2X2 },
  { title: 'Mitglied werden', detail: 'Infos zur Mitgliedschaft', href: '/mitgliedschaft/', Icon: UserRound },
  { title: 'Webcam', detail: 'Liveblick auf die Anlage', href: '/webcam/', Icon: Camera },
];
---

<div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 lg:px-8 lg:pt-10">
  <section class="grid overflow-hidden rounded-2xl md:grid-cols-2" aria-labelledby="home-hero-title">
    <div class="relative isolate overflow-hidden bg-[#173a2e] px-6 py-12 text-[#fffdf7] sm:p-12 lg:px-16 lg:py-20">
      <div aria-hidden="true" class="absolute -right-14 -bottom-12 -z-10 h-44 w-64 -rotate-32 border border-white/15">
        <div class="absolute inset-y-6 inset-x-0 border-y border-white/15"></div>
        <div class="absolute inset-y-0 inset-x-1/4 border-x border-white/15"></div>
      </div>
      <p class="flex items-center gap-3 text-xs font-bold tracking-[.16em] text-[#e2f28d] uppercase">
        <span class="h-px w-6 bg-current" aria-hidden="true"></span> Oststeiermark
      </p>
      <h1 id="home-hero-title" class="mt-6 text-5xl leading-none font-semibold tracking-tight md:text-6xl">
        Tennis in <em class="block font-['Instrument_Serif',Georgia,serif] text-[1.33em] font-normal text-[#e2f28d]">Mönichwald.</em>
      </h1>
      <p class="mt-6 max-w-sm text-base leading-relaxed text-[#e4ebdf]">Vier Plätze in Mönichwald und Waldbach. Für dein nächstes Match, fürs Training und für alle, die gerne gemeinsam spielen.</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <Button href="/reservierung/" class="bg-[#e2f28d]! text-[#152b23]! hover:bg-[#efffb0]!">Platz reservieren <ArrowUpRight size={16} aria-hidden="true" /></Button>
        <a href="#termine" class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-white underline underline-offset-4">Zu den Terminen <ArrowDown size={16} aria-hidden="true" /></a>
      </div>
    </div>
    <figure class="relative m-0 min-h-64 overflow-hidden bg-[#ae854a] sm:min-h-80">
      <img src="/design/tennisanlage.webp" alt="Luftaufnahme der beiden Sandplätze und des Vereinshauses in Mönichwald" width="1043" height="800" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
      <figcaption class="absolute right-3 bottom-3 flex items-center gap-2 rounded-md bg-[#fffdf7] px-3 py-2 text-xs font-bold text-[#173a2e]">
        <span class="size-2 rounded-full bg-[#173a2e]" aria-hidden="true"></span> Tennisanlage Mönichwald
      </figcaption>
    </figure>
  </section>
  <div role="navigation" aria-label="Rund um den Tennisplatz" class="mt-5 grid divide-y divide-[#d9dbd0] overflow-hidden rounded-2xl border border-[#d9dbd0] md:grid-cols-3 md:divide-x md:divide-y-0">
    {quickLinks.map(({title,detail,href,Icon}) => (
      <a href={href} class="group flex min-h-20 items-center gap-3 px-4 py-3 no-underline hover:bg-[#eeeadf] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#173a2e] motion-safe:transition-colors">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#e9ece0] text-[#173a2e]"><Icon size={19} aria-hidden="true" /></span>
        <span class="min-w-0"><strong class="block text-sm group-hover:underline">{title}</strong><small class="block text-xs text-[#4c5d52]">{detail}</small></span>
        <ArrowUpRight size={17} class="ml-auto shrink-0" aria-hidden="true" />
      </a>
    ))}
  </div>
</div>
