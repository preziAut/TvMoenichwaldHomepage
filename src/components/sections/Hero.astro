---
import { ArrowUpRight, CalendarDays, MapPin } from 'lucide-astro';
import Button from '../ui/Button.astro';
import SectionContainer from '../ui/SectionContainer.astro';
import hero from '../../data/hero.json';
---

<SectionContainer aria-labelledby="home-hero-title" class="border-b border-slate-200 bg-slate-50">
  <div class="grid items-center gap-8 md:grid-cols-2 lg:gap-16">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-indigo-600">Tennisverein Mönichwald</p>
      <h1 id="home-hero-title" class="mt-4 text-4xl leading-tight font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Tennis in der <span class="text-indigo-600">Oststeiermark.</span>
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-slate-600 sm:text-lg">
        Spiele in Mönichwald oder Waldbach und entdecke Trainings, Turniere und Vereinsveranstaltungen.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="/reservierung/">Platz buchen <ArrowUpRight size={16} aria-hidden="true" /></Button>
        <Button href="/veranstaltungen/" variant="secondary"><CalendarDays size={16} aria-hidden="true" /> Nächste Termine</Button>
      </div>
    </div>

    <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <img
        class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
        src={hero.src}
        srcset={hero.thumb + ' 640w, ' + hero.src + ' ' + hero.width + 'w'}
        sizes="(min-width: 768px) 50vw, 100vw"
        alt="Die beiden Sandplätze und das Vereinshaus in Mönichwald aus der Luft"
        width={hero.width}
        height={hero.height}
        fetchpriority="high"
      />
      <figcaption class="flex items-center gap-2 px-4 py-4 text-sm text-slate-600 sm:px-5">
        <MapPin size={17} class="shrink-0 text-indigo-600" aria-hidden="true" />
        Tennisanlage Mönichwald
      </figcaption>
    </figure>
  </div>
</SectionContainer>
