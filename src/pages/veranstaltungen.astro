---
import Layout from '../layouts/Layout.astro';import Filters from '../components/Filters.astro';import{getCollection}from'astro:content';const entries=(await getCollection('termine')).sort((a,b)=>b.data.start.localeCompare(a.data.start));const years=[...new Set(entries.map(p=>p.data.start.slice(0,4)))].sort().reverse();const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Vienna'}).format(new Date());
---
<Layout title="Veranstaltungen"><div class="page-head"><div class="wrap"><p class="eyebrow">Termine & Rückblicke</p><h1 class="page-title">Gemeinsam am Start.</h1><p>Turniere, Mannschaftsspiele und Tenniscamps. Alle Uhrzeiten gelten für Österreich.</p></div></div><section class="section wrap">{!entries.some(p=>p.data.end.slice(0,10)>=today)&&<p class="notice">Aktuell sind keine kommenden Termine eingetragen. Hier findest du das Veranstaltungsarchiv.</p>}<Filters years={years}/>{entries.map(({data:e})=><div data-filter-item data-year={e.start.slice(0,4)}><a class="event-row" href={e.url}><span class="event-date">{e.start.slice(0,10).split('-').reverse().join('.')}</span><div><small>{e.end.slice(0,10)<today?'Archiv':'Kommender Termin'}</small><h2>{e.title}</h2></div><span>↗</span></a></div>)}</section></Layout>
