---
import Layout from '../layouts/Layout.astro';import Filters from '../components/Filters.astro';import Card from '../components/Card.astro';import {getCollection}from'astro:content';const entries=(await getCollection('beitraege')).sort((a,b)=>b.data.year.localeCompare(a.data.year)||b.data.date.localeCompare(a.data.date));const years=[...new Set(entries.map(p=>p.data.year))].sort().reverse();
---
<Layout title="Aktuelles & Vereinsarchiv"><div class="page-head"><div class="wrap"><p class="eyebrow">Vereinsleben</p><h1 class="page-title">Geschichten vom Platz.</h1><p>Nachrichten, Turniere und gemeinsame Momente – unser Vereinsarchiv.</p></div></div><section class="section wrap"><Filters years={years} categories={[...new Set(entries.flatMap(p=>p.data.categories))]}/><div class="cards">{entries.map(p=><div data-filter-item data-year={p.data.year} data-categories={JSON.stringify(p.data.categories)}><Card {...p.data} label={`Archiv · ${p.data.year}`}/></div>)}</div></section></Layout>
