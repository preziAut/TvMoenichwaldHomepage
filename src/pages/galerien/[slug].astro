---
import Layout from '../../layouts/Layout.astro';import{getCollection}from'astro:content';export async function getStaticPaths(){return(await getCollection('galerien')).map(entry=>({params:{slug:entry.id},props:{entry}}));}const{entry}=Astro.props;const g=entry.data;
---
<Layout title={g.title}><div class="page-head"><div class="wrap"><p class="eyebrow"><a href="/bilder/">Bilder</a> / Galerie</p><h1 class="page-title">{g.title}</h1><p>{g.images.length} Bilder aus unserem Vereinsleben.</p></div></div><section class="section wrap"><div class="gallery-grid">{g.images.map((img,i)=><figure><a href={img.src} data-gallery-index={i} data-caption={img.caption||img.alt}><img src={img.thumb||img.src} alt={img.alt} loading="lazy" width="640" height="480"/></a>{img.caption&&<figcaption>{img.caption}</figcaption>}</figure>)}</div>{!g.images.length&&<p>Für diese historische Galerie waren keine Bilder zugeordnet.</p>}<dialog aria-label="Bildansicht"><div class="controls"><button data-prev aria-label="Vorheriges Bild">←</button><button data-close>Schließen ×</button><button data-next aria-label="Nächstes Bild">→</button></div><img alt=""/><p data-caption></p></dialog></section></Layout>
<script>const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-index]')];const dialog=document.querySelector('dialog')!;let current=0;let opener:HTMLElement|null=null;function show(i:number){current=(i+links.length)%links.length;const a=links[current];dialog.querySelector('img')!.src=a.href;dialog.querySelector('img')!.alt=a.dataset.caption||'';dialog.querySelector('[data-caption]')!.textContent=`${current+1} / ${links.length} — ${a.dataset.caption||''}`;}links.forEach((a,i)=>a.addEventListener('click',e=>{e.preventDefault();opener=a;show(i);dialog.showModal();}));dialog.querySelector('[data-prev]')?.addEventListener('click',()=>show(current-1));dialog.querySelector('[data-next]')?.addEventListener('click',()=>show(current+1));dialog.querySelector('[data-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>opener?.focus());dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')show(current-1);if(e.key==='ArrowRight')show(current+1);});</script>
