---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from '../../components/ui/SectionContainer.astro';
import Button from '../../components/ui/Button.astro';
---
<Layout title="Platzbuchung" noindex={true}>
  <SectionContainer>
    <a href="/reservierung/" class="text-sm font-semibold underline">Zur Standortübersicht</a>
    <h1 id="booking-title" class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Platzbuchung</h1>
    <p id="booking-status" role="status" class="my-4 text-slate-700">Kalender wird geladen …</p>
    <div id="booking-login" hidden>
      <Button href="/meisterschaften/anmelden/" tone="clay">Mit Vereinskonto anmelden</Button>
    </div>
    <div id="booking-controls" hidden class="my-5 flex flex-wrap items-end gap-4 rounded-xl border border-stone-200 bg-white p-4">
      <label class="mb-0">Datum <input id="booking-day" type="date" required /></label>
      <label class="mb-0">Spieldauer <select id="booking-duration" class="mt-2 block rounded-lg border border-stone-300 bg-white p-2.5"></select></label>
    </div>
    <div id="booking-courts" class="grid gap-5 sm:grid-cols-2"></div>
    <form id="booking-policy" hidden class="mt-6 max-w-md rounded-xl border border-stone-200 bg-white p-5">
      <h2 class="mb-4 text-lg font-bold">Stornierungsregeln</h2>
      <label><input name="enabled" type="checkbox" /> Selbststornierung erlauben</label>
      <label>Frist vor Beginn (Sekunden) <input name="seconds" type="number" min="0" max="2592000" step="1" required /></label>
      <Button type="submit" tone="clay">Speichern</Button>
    </form>
  </SectionContainer>
</Layout>

<script>
  import '../../scripts/platzbuchung.ts';
</script>
