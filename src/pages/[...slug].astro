---
import Layout from '../layouts/Layout.astro';import ContactForm from '../components/ContactForm.astro';import {getCollection,render} from 'astro:content';import {site} from '../config';
export async function getStaticPaths(){const entries=[...await getCollection('seiten'),...await getCollection('beitraege'),...await getCollection('ergebnisse')];return entries.filter(e=>!['/','/bilder/','/veranstaltungen/'].includes(e.data.url)).map(entry=>({params:{slug:entry.data.url.slice(1,-1)},props:{entry}}));}
const {entry}=Astro.props;const {Content}=await render(entry);const d=entry.data;
---
<Layout title={d.title} description={d.description}><div class="page-head"><div class="wrap"><p class="eyebrow"><a href="/">Startseite</a> / {entry.collection==='seiten'?'Unser Verein':'Vereinsarchiv'}</p><h1 class="page-title">{d.title==='Vereinsgeschichte'?'Unser Verein. Unsere Geschichte.':d.title}</h1>{entry.collection!=='seiten'&&<p>Archivbeitrag · {d.year} · Ursprünglich veröffentlicht am {d.date.split('-').reverse().join('.')}</p>}</div></div><div class="wrap"><div class="content">
{d.url==='/reservierung/'&&<><div class="booking-grid">{site.bookings.map(b=><div class="booking"><p class="eyebrow">Platzreservierung</p><h2>{b.name}</h2><p>{b.description}</p><a class="button" href={b.url}>Platz buchen ↗</a></div>)}</div><p class="notice">Anmeldung und Buchung erfolgen im jeweiligen bestehenden Buchungsportal. Die Konten beider Vereine bleiben getrennt.</p></>}
{['/mitgliedschaft/','/reservierung/'].includes(d.url)&&<p class="notice">Die folgenden Beiträge stammen aus dem bisherigen Webauftritt. Dort unterscheiden sich die Preisangaben. Bitte die aktuell gültigen Beträge vor einer Überweisung beim Verein erfragen.</p>}
{d.url==='/webcam/'?<section>{site.webcam?<><img id="webcam" src={site.webcam} alt="Aktuelles Webcam-Bild der Tennisanlage" data-source={site.webcam}/><p id="webcam-status" role="status">Das Bild wird alle 60 Sekunden neu angefordert.</p></>:<p class="notice">Das aktuelle Webcam-Bild ist derzeit nicht verfügbar. Die Bildquelle wird für den neuen Webauftritt eingerichtet.</p>}</section>:<div class="prose"><Content/></div>}
{d.url==='/kontakt/'&&<ContactForm/>}
</div></div></Layout>
<script>const img=document.querySelector<HTMLImageElement>('#webcam');const status=document.querySelector('#webcam-status');if(img){img.addEventListener('error',()=>{if(status)status.textContent='Das Webcam-Bild ist gerade nicht erreichbar.';});img.addEventListener('load',()=>{if(status)status.textContent='Bild geladen um '+new Date().toLocaleTimeString('de-AT')+'. Aktualisierung alle 60 Sekunden.';});setInterval(()=>{if(document.hidden)return;const u=new URL(img.dataset.source!);u.searchParams.set('t',String(Date.now()));img.src=u.href;},60000);}</script>
