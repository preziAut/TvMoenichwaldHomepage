---
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {getCollection} from 'astro:content';import hero from '../data/hero.json';
const posts=(await getCollection('beitraege')).filter(p=>p.data.image).sort((a,b)=>b.data.year.localeCompare(a.data.year)||(b.data.modified||b.data.date).localeCompare(a.data.modified||a.data.date)).slice(0,3);
const events=(await getCollection('termine')).filter(e=>e.data.end.slice(0,10)>=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Vienna'}).format(new Date())).sort((a,b)=>a.data.start.localeCompare(b.data.start)).slice(0,3);
---
<Layout title="Tennis. Gemeinschaft. Mönichwald."><section class="hero"><img src={hero.src} alt="Die beiden Sandplätze und das Vereinshaus in Mönichwald aus der Luft" width="1600" height="720" fetchpriority="high"/><div class="wrap"><p class="eyebrow">Willkommen beim TV Mönichwald</p><h1>Unser Platz.<br/>Dein <em>Spiel.</em></h1><p>Für den ersten Aufschlag. Für das nächste Match.<br/>Und für die gute Zeit danach.</p><div class="actions"><a class="button" href="/reservierung/">Jetzt Platz reservieren ↗</a><a class="button secondary" href="/verein/">Unseren Verein entdecken</a></div></div></section><div class="hero-foot"><div class="wrap"><a href="/reservierung/"><b>01</b> Zwei Sandplätze. Dein nächstes Match. <span>↗</span></a><a href="/mitgliedschaft/"><b>02</b> Gemeinsam mehr erleben. <span>↗</span></a><a href="/veranstaltungen/"><b>03</b> Was bei uns los ist. <span>↗</span></a></div></div>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Aus unserem Vereinsleben</p><h2>Momente, die bleiben.</h2></div><a class="text-link" href="/aktuelles/">Alle Beiträge ansehen ↗</a></div><div class="cards">{posts.map(p=><Card {...p.data} label={`Aus dem Archiv · ${p.data.year}`}/>)}</div></div></section>
<section class="section club-section"><div class="wrap split"><img src={hero.src} alt="Tennisanlage Mönichwald" loading="lazy" width="1043" height="800"/><div><p class="eyebrow">Zuhause am Tennisplatz</p><h2>Ein Sport.<br/>Viele Verbindungen.</h2><p>Seit 1978 gehört Tennis zu Mönichwald. Aus dem ersten Platz wurden zwei Sandplätze, ein Vereinshaus und viele gemeinsame Geschichten. Ob Training, Turnier oder eine Runde unter Freunden – hier kommen wir zusammen.</p><a class="text-link" href="/verein/">Unsere Geschichte kennenlernen ↗</a><div class="stats"><div><b>1978</b><span>Beginn unserer Geschichte</span></div><div><b>2</b><span>Sandplätze in Mönichwald</span></div></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Dabei sein</p><h2>Wir sehen uns am Platz.</h2></div><a class="text-link" href="/veranstaltungen/">Zum Veranstaltungskalender ↗</a></div>{events.length?events.map(({data:e})=><a class="event-row" href={e.url}><span class="event-date">{e.start.slice(0,10).split('-').reverse().join('.')}</span><h3>{e.title}</h3><span>↗</span></a>):<p>Neue Termine werden hier bekanntgegeben. Vergangene Veranstaltungen findest du in unserem <a href="/veranstaltungen/">Terminarchiv</a>.</p>}</div></section><section class="wrap section"><div class="callout"><div><p class="eyebrow" style="color:#ecc5a7">Lust auf Tennis?</p><h2>Dein nächstes Match wartet.</h2><p>Reserviere in Mönichwald oder Waldbach.</p></div><a class="button" href="/reservierung/">Zur Platzreservierung ↗</a></div></section></Layout>
