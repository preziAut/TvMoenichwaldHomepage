---
import Hero from '../components/sections/Hero.astro';
import Layout from '../layouts/Layout.astro';import Card from '../components/Card.astro';import {getCollection} from 'astro:content';import hero from '../data/hero.json';
const posts=(await getCollection('beitraege')).filter(p=>p.data.image).sort((a,b)=>b.data.year.localeCompare(a.data.year)||(b.data.modified||b.data.date).localeCompare(a.data.modified||a.data.date)).slice(0,3);
const today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Vienna'}).format(new Date());
const events=(await getCollection('termine')).filter(e=>e.data.end.slice(0,10)>=today).sort((a,b)=>a.data.start.localeCompare(b.data.start)).slice(0,3);
---
<Layout title="Tennis. Gemeinschaft. Mönichwald.">
<Hero />
<div class="hero-foot"><div class="wrap"><a href="/reservierung/"><b>01</b> Zwei Standorte. Vier Plätze. <span>↗</span></a><a href="/turniere/"><b>02</b> Meisterschaften & Turniere <span>↗</span></a><a href="/veranstaltungen/"><b>03</b> Zum Veranstaltungskalender <span>↗</span></a></div></div>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Dabei sein</p><h2>Nächste Termine</h2></div><a class="text-link" href="/veranstaltungen/">Zum Veranstaltungskalender ↗</a></div>{events.length?events.map(({data:e})=><a class="event-row" href={e.url}><span class="event-date">{e.start.slice(0,10).split('-').reverse().join('.')}</span><h3>{e.title}</h3><span>↗</span></a>):<p>Neue Termine werden hier bekanntgegeben. Vergangene Veranstaltungen findest du in unserem <a href="/veranstaltungen/">Terminarchiv</a>.</p>}</div></section><section class="wrap section tournament-home"><div class="callout"><div><p class="eyebrow">Wettbewerbe im Verein</p><h2>Auf dem Platz entscheidet sich’s.</h2><p>Einzel, Doppel und Mixed: Entdecke unsere Turniere und die Ergebnisse vergangener Bewerbe.</p></div><a class="button" href="/turniere/">Zu den Turnieren ↗</a></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Aus unserem Vereinsleben</p><h2>Momente, die bleiben.</h2></div><a class="text-link" href="/aktuelles/">Alle Beiträge ansehen ↗</a></div><div class="cards">{posts.map(p=><Card {...p.data} label={p.data.year===today.slice(0,4)?'Aktuell · '+p.data.year:'Aus dem Archiv · '+p.data.year}/>)}</div></div></section>
<section class="section club-section"><div class="wrap split"><img src={hero.src} alt="Tennisanlage Mönichwald" loading="lazy" width="1043" height="800"/><div><p class="eyebrow">Zuhause am Tennisplatz</p><h2>Ein Sport.<br/>Viele Verbindungen.</h2><p>Seit 1978 gehört Tennis zu Mönichwald. Aus dem ersten Platz wurden zwei Sandplätze, ein Vereinshaus und viele gemeinsame Geschichten. Ob Training, Turnier oder eine Runde unter Freunden – hier kommen wir zusammen.</p><a class="text-link" href="/verein/">Unsere Geschichte kennenlernen ↗</a><div class="stats"><div><b>1978</b><span>Beginn unserer Geschichte</span></div><div><b>2</b><span>Sandplätze in Mönichwald</span></div></div></div></div></section>
<section class="wrap section"><div class="callout"><div><p class="eyebrow" style="color:#ecc5a7">Lust auf Tennis?</p><h2>Dein nächstes Match wartet.</h2><p>Reserviere in Mönichwald oder Waldbach.</p></div><a class="button" href="/reservierung/">Zur Platzreservierung ↗</a></div></section></Layout>
<style>
  .tournament-home { padding-top: 0; }
  .tournament-home .eyebrow { color: #ecc5a7; }
</style>
