---
import { ArrowUpRight } from 'lucide-astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import SectionContainer from '../components/ui/SectionContainer.astro';
import Button from '../components/ui/Button.astro';

const features = [
  { id: '669', label: 'Turnier', title: 'Sektturnier 2024', image: 'sektturnier.webp' },
  { id: '677', label: 'Nachwuchs', title: 'Kinder-Tenniscamp', image: 'kindercamp.webp' },
  { id: '679', label: 'Meisterschaft', title: 'Herren-Doppel', image: 'doppelmeisterschaft.webp' },
];
const posts = await getCollection('beitraege');
const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Vienna' }).format(new Date());
const events = (await getCollection('termine'))
  .filter(({ data }) => data.end.slice(0, 10) >= today)
  .sort((a, b) => a.data.start.localeCompare(b.data.start)).slice(0, 3);
const displayTitle = "font-['Instrument_Serif',Georgia,serif] text-5xl leading-none font-normal tracking-tight sm:text-6xl";
const labelStyle = 'mb-3 text-xs font-bold tracking-[.15em] text-[#4c5d52] uppercase';
const linkStyle = 'inline-flex min-h-11 items-center gap-2 text-sm font-bold underline underline-offset-4';
---

<Layout title="Tennis in der Oststeiermark">
  <Hero />
  <SectionContainer id="termine" class="scroll-mt-5" aria-labelledby="termintitel">
    <div class="grid items-center gap-6 md:grid-cols-2">
      <div><p class={labelStyle}>Vereinskalender</p><h2 class={displayTitle} id="termintitel">Nächste Termine</h2></div>
      <div>
        {events.length ? (
          <ul class="mb-4 grid list-none gap-2 p-0">
            {events.map(({data}) => <li><a class="flex items-baseline gap-3 rounded-lg border border-[#d9dbd0] px-3 py-2 hover:bg-[#eeeadf]" href={data.url}><time class="shrink-0 text-xs font-bold" datetime={data.start.slice(0,10)}>{data.start.slice(0,10).split('-').reverse().join('.')}</time><span>{data.title}</span></a></li>)}
          </ul>
        ) : <p class="mb-4 max-w-sm leading-relaxed text-[#4c5d52]">Neue Termine werden im Vereinskalender veröffentlicht. Dort findest du auch vergangene Veranstaltungen.</p>}
        <Button href="/veranstaltungen/" variant="secondary" class="border-[#173a2e]! bg-transparent! text-[#173a2e]! hover:bg-[#173a2e]! hover:text-white!">Kalender öffnen <ArrowUpRight size={16} aria-hidden="true" /></Button>
      </div>
    </div>
  </SectionContainer>

  <SectionContainer id="aktuelles" class="scroll-mt-5 bg-[#eeeadf]" aria-labelledby="aktuelltitel">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <div><p class={labelStyle}>Aus dem Vereinsarchiv</p><h2 class={displayTitle} id="aktuelltitel">Unser Vereinsleben</h2></div>
      <a href="/aktuelles/" class={linkStyle}>Alle Beiträge <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {features.map((feature) => {
        const post = posts.find(({data}) => data.legacyId === feature.id);
        if (!post) return null;
        return <article class="h-full">
          <a href={post.data.url} class="group flex h-full flex-col overflow-hidden rounded-xl border border-[#d9dbd0] bg-[#fffdf7] no-underline hover:border-[#4c5d52] motion-safe:transition-colors">
            <div class="aspect-[10/3] overflow-hidden"><img src={'/design/' + feature.image} alt="" width="640" height="192" loading="lazy" class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105" /></div>
            <div class="flex grow items-end justify-between gap-2 p-5">
              <div><p class={labelStyle}>{feature.label} · {post.data.year}</p><h3 class="font-['Instrument_Serif',Georgia,serif] text-3xl leading-none font-normal">{feature.title}</h3></div>
              <ArrowUpRight size={18} class="shrink-0" aria-hidden="true" />
            </div>
          </a>
        </article>;
      })}
    </div>
  </SectionContainer>

  <SectionContainer id="verein" class="scroll-mt-5" aria-labelledby="vereinstitel">
    <div class="grid gap-7 rounded-2xl bg-[#173a2e] px-6 py-10 text-[#fffdf7] sm:p-12 md:grid-cols-2 md:items-center">
      <div>
        <p class="mb-3 text-xs font-bold tracking-[.15em] text-[#e2f28d] uppercase">Über den Verein</p>
        <h2 class={displayTitle} id="vereinstitel">Auf dem Platz <em class="text-[#e2f28d]">seit 1978.</em></h2>
      </div>
      <div>
        <p class="mb-4 max-w-md leading-relaxed text-[#e4ebdf]">Aus dem ersten Tennisplatz in Mönichwald wurden zwei Sandplätze und ein Vereinshaus. Heute treffen wir uns hier zum Training, bei Turnieren und für eine Runde unter Freunden.</p>
        <a href="/verein/" class={linkStyle}>Unsere Geschichte <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
    </div>
  </SectionContainer>
</Layout>
