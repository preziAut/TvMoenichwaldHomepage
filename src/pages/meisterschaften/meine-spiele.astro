---
import { championshipButton } from '../../scripts/meisterschaft-buttons.ts';
import Layout from '../../layouts/Layout.astro';
import SectionContainer from '../../components/ui/SectionContainer.astro';
---
<Layout title="Meine Spiele">
  <SectionContainer aria-labelledby="title">
    <a href="/meisterschaften/" class="text-sm font-semibold underline underline-offset-4">Einzelmeisterschaften</a>
    <h1 id="title" class="mt-4 text-4xl font-bold text-[#173a2e]">Meine Spiele</h1>
    <a id="my-matches-login" hidden href="/meisterschaften/anmelden/" class:list={[championshipButton.primary, 'mt-3']}>Anmelden</a>
    <p id="match-status" class="mt-4" role="status">Spiele werden geladen …</p>
    <div id="match-list" class="mt-5 grid gap-4 sm:grid-cols-2"></div>
  </SectionContainer>
</Layout>

<script>
  import { championshipButton } from '../../scripts/meisterschaft-buttons.ts';
  const list = document.querySelector('#match-list')!;
  const status = document.querySelector('#match-status')!;
  const labels: Record<string, string> = { open: 'Offen', submitted: 'Wartet auf Bestätigung', disputed: 'Strittig',
    confirmed: 'Bestätigt', completed: 'Abgeschlossen' };
  type Match = { id: string; version: number; status: string; title: string; home: string | null; away: string | null;
    proposedScore: string | null; action: 'review' | 'submit' | null };
  const element = <K extends keyof HTMLElementTagNameMap>(tag: K, label: string, classes: string) => {
    const node = document.createElement(tag);
    node.textContent = label;
    node.className = classes;
    return node;
  };
  const buttonClasses = championshipButton.primary;

  async function change(match: Match, action: string, error: HTMLElement, button: HTMLButtonElement, score?: number[][]) {
    button.disabled = true;
    error.textContent = '';
    try {
      const response = await fetch(`/api/spiele/${encodeURIComponent(match.id)}/${action}`, { method: 'POST',
        headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ version: match.version, score }) });
      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error ?? 'Speichern fehlgeschlagen.');
      }
      await load();
    } catch (failure) { error.textContent = failure instanceof Error ? failure.message : 'Speichern fehlgeschlagen.'; }
    finally { button.disabled = false; }
  }

  function show(match: Match) {
    const card = element('article', '', 'rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6');
    card.append(element('p', match.title, 'text-sm text-[#4c5d52]'),
      element('h2', `${match.home ?? 'Offen'} – ${match.away ?? 'Offen'}`, 'mt-2 text-lg font-bold break-words'),
      element('p', labels[match.status] ?? '', 'my-3 text-sm font-semibold'));
    const error = element('p', '', 'mt-2 text-sm text-red-800');
    error.setAttribute('role', 'status');
    if (match.action === 'submit') {
      const form = element('form', '', 'grid gap-2');
      const sets: HTMLInputElement[][] = [];
      for (let set = 1; set <= 3; set++) {
        const field = element('fieldset', '', 'grid grid-cols-2 gap-2');
        field.append(element('legend', `Satz ${set}${set === 3 ? ' (falls nötig)' : ''}`, 'text-sm font-semibold'));
        const inputs = [match.home, match.away].map((player, index) => {
          const label = element('label', player ?? `Spieler ${index + 1}`, 'min-w-0! mb-1! break-words');
          const input = element('input', '', 'min-h-11 rounded-lg');
          input.type = 'number'; input.min = '0'; input.max = '7'; input.inputMode = 'numeric'; input.required = set < 3;
          label.append(input); field.append(label); return input;
        });
        sets.push(inputs);
        form.append(field);
      }
      const submit = element('button', 'Ergebnis melden', buttonClasses);
      form.append(submit);
      form.addEventListener('submit', event => {
        event.preventDefault();
        const entered = sets.filter(set => set.some(input => input.value !== ''));
        if (entered.some(set => set.some(input => input.value === ''))) { error.textContent = 'Bitte beide Satzstände eintragen.'; return; }
        const score = entered.map(set => set.map(input => Number(input.value)));
        if (confirm(`Ergebnis ${score.map(set => set.join(':')).join(', ')} melden?`)) void change(match, 'ergebnis', error, submit, score);
      });
      card.append(form);
    } else if (match.action === 'review' && match.proposedScore) {
      const score: number[][] = JSON.parse(match.proposedScore);
      const buttons = element('div', '', 'flex flex-wrap gap-2');
      for (const [name, action] of [['Bestätigen', 'bestaetigen'], ['Beanstanden', 'beanstanden']]) {
        const button = element('button', name, buttonClasses);
        button.onclick = () => { if (confirm(`${name}?`)) void change(match, action, error, button); };
        buttons.append(button);
      }
      card.append(element('p', score.map(set => set.join(':')).join(', '), 'mb-3 font-bold'), buttons);
    }
    card.append(error);
    return card;
  }

  async function load() {
    const response = await fetch('/api/meine-spiele');
    document.querySelector<HTMLElement>('#my-matches-login')!.hidden = response.status !== 401;
    if (!response.ok) { status.textContent = response.status === 401 ? 'Melde dich an, um deine Begegnungen zu sehen.' : 'Spiele sind derzeit nicht verfügbar.'; return; }
    const matches: Match[] = await response.json();
    status.textContent = matches.length ? '' : 'Dir sind noch keine Begegnungen zugeordnet.';
    list.replaceChildren(...matches.map(show));
  }
  load().catch(() => { status.textContent = 'Spiele konnten nicht geladen werden.'; });
</script>
