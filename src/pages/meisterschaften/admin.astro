---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from '../../components/ui/SectionContainer.astro';
---
<Layout title="Meisterschaften verwalten">
  <SectionContainer aria-labelledby="title">
    <a href="/meisterschaften/" class="text-sm font-semibold underline underline-offset-4">Einzelmeisterschaften</a>
    <h1 id="title" class="my-4 text-4xl font-bold text-[#173a2e]">Meisterschaften verwalten</h1>
    <p id="admin-status" role="status" class="my-4 text-sm"></p>
    <p class="my-4"><a class="text-sm font-semibold underline" href="/meisterschaften/anmelden/">Zum Vereinslogin</a></p>
    <label id="existing-label" hidden>Vorhandene Meisterschaft öffnen<select id="existing" class="mt-2 block w-full max-w-lg rounded-lg border border-[#9fa995] p-3"><option value="">Bitte auswählen</option></select></label>
    <button id="new-draft" type="button" hidden class="mb-4 min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Neue Meisterschaft</button>
    <div class="grid gap-5 lg:grid-cols-2">
      <form id="create" class="rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6">
        <h2 class="mb-4 text-xl font-bold">Neue Meisterschaft</h2>
        <label>Titel<input name="title" required maxlength="120" /></label>
        <label>Beginn<input name="startsOn" type="date" required /></label>
        <label>Folgephase<select name="phaseTwo" class="mt-2 block w-full rounded-lg border border-[#9fa995] p-3"><option value="placement">Platzierungsgruppen</option><option value="knockout">K.-o.-Runde</option></select></label>
        <label>Sichtbarkeit<select name="visibility" class="mt-2 block w-full rounded-lg border border-[#9fa995] p-3"><option value="club">Vereinsintern</option><option value="public">Öffentlich</option></select></label>
        <button class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white">Entwurf anlegen</button>
      </form>
      <div id="setup" hidden class="space-y-4 rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6">
        <h2 id="draft-title" class="text-xl font-bold"></h2>
        <form id="reuse-player">
          <label>Vorhandenen Kontakt auswählen<select id="available-players" name="playerId" required class="mt-2 block w-full rounded-lg border border-[#9fa995] p-3"></select></label>
          <button class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white disabled:opacity-50">Kontakt zur Meisterschaft hinzufügen</button>
        </form>
        <form id="player">
          <h3 class="mb-3 font-semibold">Neuen Kontakt anlegen</h3>
          <label>Vorname<input name="firstName" required maxlength="70" /></label>
          <label>Nachname<input name="lastName" required maxlength="70" /></label>
          <button class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Teilnehmer hinzufügen</button>
        </form>
        <form id="seeds">
          <fieldset><legend class="mb-3 font-semibold">Setzliste <span id="participant-count" class="font-normal"></span></legend><div id="seed-rows"></div></fieldset>
          <button class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Setzliste speichern</button>
        </form>
        <form id="draw">
          <label>Anzahl Gruppen<input name="groupCount" type="number" min="1" max="16" required value="2" /></label>
          <label><input id="manual-toggle" type="checkbox" /> Gruppen manuell zuweisen</label>
          <div id="manual-groups" hidden></div>
          <label id="manual-reason" hidden>Begründung bei ungleich großen Gruppen<input name="reason" maxlength="500" /></label>
          <button class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Auslosung ansehen</button>
        </form>
        <ol id="preview" class="space-y-2"></ol>
        <form id="start" hidden>
          <label><input name="publish" type="checkbox" /> Meisterschaft veröffentlichen</label>
          <label><input name="allowSubmissions" type="checkbox" /> Ergebnismeldung durch Spieler zulassen</label>
          <button class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white">Vorrunde starten</button>
        </form>
      </div>
      <form id="phase" hidden class="min-w-0 rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6 lg:col-span-2">
        <h2 class="mb-4 text-xl font-bold">Turnierphase verwalten</h2>
        <label>Anzahl Qualifikanten (K.-o.)<input name="qualifiers" type="number" min="2" max="8" value="4" /></label>
        <label><input name="bronze" type="checkbox" /> Spiel um Platz 3</label>
        <p id="phase-preview" class="my-3 whitespace-pre-line text-sm"></p>
        <div id="knockout-preview" class="min-w-0 space-y-4"></div>
        <div class="flex flex-wrap gap-2">
          <button name="action" value="preview" class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Folgephase ansehen</button>
          <button name="action" value="start" class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Folgephase starten</button>
          <button name="action" value="finish" class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white">Meisterschaft abschließen</button>
        </div>
      </form>
      <section id="result-panel" hidden class="rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6 lg:col-span-2" aria-labelledby="results-title">
        <h2 id="results-title" tabindex="-1" class="mb-4 text-xl font-bold">Begegnungen und Ergebnisse</h2>
        <a id="public-detail" class="mb-4 inline-block font-semibold underline underline-offset-4" href="/meisterschaften/">Spielplan und Tabelle ansehen</a>
        <div id="result-list" class="grid gap-3 sm:grid-cols-2"></div>
      </section>
      <form id="invite" class="rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6">
        <h2 class="mb-4 text-xl font-bold">Vereinszugang einladen</h2>
        <label>E-Mail-Adresse<input name="email" type="email" required maxlength="254" /></label>
        <button class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white">Einladung senden</button>
      </form>
      <form id="access" hidden class="rounded-xl border border-[#d9dbd0] bg-white p-4 sm:p-6">
        <h2 class="mb-4 text-xl font-bold">Spieler freischalten</h2>
        <label>Vereinskonto<select name="email" id="accounts" required class="mt-2 block w-full rounded-lg border border-[#9fa995] p-3"></select></label>
        <label>Spielerprofil<select name="playerId" id="players" class="mt-2 block w-full rounded-lg border border-[#9fa995] p-3"></select></label>
        <label><input name="canSubmit" type="checkbox" /> Ergebnismeldungen erlauben</label>
        <div class="flex flex-wrap gap-2">
          <button name="action" value="link" class="min-h-11 rounded-lg bg-[#173a2e] px-4 py-2 font-semibold text-white">Zuordnung speichern</button>
          <button name="action" value="disable" class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Konto sperren</button>
          <button name="action" value="enable" class="min-h-11 rounded-lg border border-[#173a2e] px-4 py-2 font-semibold">Konto entsperren</button>
        </div>
      </form>
    </div>
  </SectionContainer>
</Layout>

<script>
  import { resultCard, type AdminMatch } from '../../scripts/meisterschaft-results.ts';
  import { bracketRound, renderBracket, type BracketMatch } from '../../scripts/meisterschaft-bracket.ts';
  const status = document.querySelector<HTMLElement>('#admin-status')!;
  const setup = document.querySelector<HTMLElement>('#setup')!;
  const preview = document.querySelector<HTMLOListElement>('#preview')!;
  const start = document.querySelector<HTMLFormElement>('#start')!;
  const existing = document.querySelector<HTMLSelectElement>('#existing')!;
  const phaseForm = document.querySelector<HTMLFormElement>('#phase')!;
  const knockoutPreview = document.querySelector<HTMLElement>('#knockout-preview')!;
  const seedRows = document.querySelector('#seed-rows')!;
  const manualToggle = document.querySelector<HTMLInputElement>('#manual-toggle')!;
  const manualGroups = document.querySelector<HTMLElement>('#manual-groups')!;
  const createForm = document.querySelector<HTMLFormElement>('#create')!;
  const newDraft = document.querySelector<HTMLButtonElement>('#new-draft')!;
  const resultPanel = document.querySelector<HTMLElement>('#result-panel')!;
  const results = document.querySelector<HTMLElement>('#result-list')!;
  type Summary = { id: string; title: string; version: number; status: string };
  type Entry = { id: string; display_name: string; seed: number | null };
  type Contact = { id: string; display_name: string; active: number };
  let entries: Entry[] = [];
  let contacts: Contact[] = [];
  let draft: { id: string; version: number } | null = null;
  let knockoutSlots: (string | null)[] | undefined;
  let suggested: { groupCount: number; seed: number; groups?: string[][]; reason?: string } | null = null;

  function bind(id: string, run: (data: FormData) => Promise<void>) {
    const form = document.querySelector<HTMLFormElement>(`#${id}`)!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const button = (event as SubmitEvent).submitter as HTMLButtonElement ?? form.querySelector('button')!;
      const fields = new FormData(form, button);
      button.disabled = true;
      status.textContent = '';
      try { await run(fields); }
      catch (error) { status.textContent = error instanceof Error ? error.message : 'Aktion fehlgeschlagen.'; }
      finally { button.disabled = false; }
    });
  }

  async function post(path: string, value: object) {
    const response = await fetch(`/api/meisterschaften${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(value) });
    const output = await response.json();
    if (!response.ok) throw new Error(output.error ?? 'Aktion fehlgeschlagen.');
    return output;
  }

  async function openCompetition(item: Summary) {
    draft = { id: item.id, version: item.version };
    start.hidden = true;
    suggested = null;
    preview.replaceChildren();
    setup.hidden = item.status !== 'draft';
    createForm.hidden = true;
    newDraft.hidden = false;
    phaseForm.hidden = !['groups_active', 'phase_active'].includes(item.status);
    for (const button of phaseForm.querySelectorAll<HTMLButtonElement>('button[name="action"]')) {
      button.hidden = item.status === 'phase_active' ? button.value !== 'finish' : button.value === 'finish';
    }
    document.querySelector('#phase-preview')!.textContent = '';
    knockoutSlots = undefined;
    knockoutPreview.replaceChildren();
    resultPanel.hidden = item.status === 'draft';
    results.replaceChildren();
    history.replaceState(null, '', `?id=${encodeURIComponent(item.id)}`);
    document.querySelector('#draft-title')!.textContent = item.title;
    if (item.status === 'draft') {
      const response = await fetch(`/api/meisterschaften/${encodeURIComponent(item.id)}/teilnehmer`);
      if (!response.ok) throw new Error('Teilnehmer konnten nicht geladen werden.');
      entries = await response.json();
      renderSeeds();
    } else await loadResults(item.id);
  }

  async function loadResults(id: string) {
    const response = await fetch(`/api/meisterschaften/${encodeURIComponent(id)}`);
    if (!response.ok) throw new Error('Begegnungen konnten nicht geladen werden.');
    const { matches }: { matches: AdminMatch[] } = await response.json();
    if (draft?.id !== id) return;
    const cards = matches.map(match => resultCard(match, () => loadResults(id)));
    results.replaceChildren(...(cards.length ? cards : [document.createTextNode('Für diese Meisterschaft gibt es noch keine Begegnungen.')]));
    document.querySelector<HTMLAnchorElement>('#public-detail')!.href = `/meisterschaften/?id=${encodeURIComponent(id)}`;
  }

  newDraft.onclick = () => {
    draft = null;
    setup.hidden = true; phaseForm.hidden = true; resultPanel.hidden = true;
    newDraft.hidden = true; createForm.hidden = false;
    existing.value = '';
    history.replaceState(null, '', location.pathname);
    createForm.querySelector<HTMLInputElement>('input[name="title"]')?.focus();
  };

  function renderSeeds() {
    document.querySelector('#participant-count')!.textContent = `(${entries.length})`;
    renderAvailableContacts();
    seedRows.replaceChildren(...entries.map(entry => {
      const label = document.createElement('label');
      label.textContent = entry.display_name;
      const input = document.createElement('input');
      input.type = 'number'; input.min = '1'; input.max = '32'; input.name = entry.id;
      input.placeholder = 'Ungesetzt'; input.value = entry.seed?.toString() ?? '';
      label.append(input);
      return label;
    }));
    manualGroups.replaceChildren(...entries.map(entry => {
      const label = document.createElement('label');
      label.textContent = `Gruppe für ${entry.display_name}`;
      const input = document.createElement('input');
      input.type = 'number'; input.inputMode = 'numeric'; input.min = '1'; input.max = '16'; input.name = `group-${entry.id}`;
      label.append(input);
      return label;
    }));
  }
  function renderAvailableContacts() {
    const available = contacts.filter(contact => contact.active && !entries.some(entry => entry.id === contact.id));
    const select = document.querySelector<HTMLSelectElement>('#available-players')!;
    select.replaceChildren(new Option(available.length ? 'Bitte auswählen' : 'Keine weiteren aktiven Kontakte', ''),
      ...available.map(contact => new Option(contact.display_name, contact.id)));
    document.querySelector<HTMLButtonElement>('#reuse-player button')!.disabled = available.length === 0;
  }
  manualToggle.onchange = () => {
    manualGroups.hidden = !manualToggle.checked;
    document.querySelector<HTMLElement>('#manual-reason')!.hidden = !manualToggle.checked;
    suggested = null;
    start.hidden = true;
    preview.replaceChildren();
  };

  async function listCompetitions() {
    const response = await fetch('/api/meisterschaften');
    if (!response.ok) return;
    const items: Summary[] = await response.json();
    const editable = items.filter(item => typeof item.version === 'number');
    existing.replaceChildren(new Option('Bitte auswählen', ''), ...editable.map(item => new Option(item.title, item.id)));
    document.querySelector<HTMLElement>('#existing-label')!.hidden = editable.length === 0;
    existing.onchange = () => {
      const item = editable.find(row => row.id === existing.value);
      if (item) openCompetition(item).catch(error => { status.textContent = error.message; });
    };
    const current = draft?.id ?? new URLSearchParams(location.search).get('id');
    existing.value = current ?? '';
    if (!draft && current) {
      const item = editable.find(row => row.id === current);
      if (item) await openCompetition(item);
    }
  }

  bind('create', async fields => {
    const saved = await post('', Object.fromEntries(fields));
    await openCompetition({ ...saved, title: String(fields.get('title')), status: 'draft' });
    createForm.reset();
    status.textContent = 'Entwurf gespeichert. Füge jetzt die Teilnehmer hinzu.';
    document.querySelector<HTMLInputElement>('#player input[name="firstName"]')?.focus();
    await listCompetitions();
  });
  async function addParticipant(fields: FormData) {
    if (!draft) return;
    draft = await post(`/${draft.id}/teilnehmer`, { ...Object.fromEntries(fields), version: draft.version });
    const response = await fetch(`/api/meisterschaften/${encodeURIComponent(draft!.id)}/teilnehmer`);
    if (response.ok) { entries = await response.json(); renderSeeds(); }
    document.querySelector<HTMLFormElement>('#player')!.reset();
    start.hidden = true;
    preview.replaceChildren();
    status.textContent = 'Teilnehmer hinzugefügt.';
  }
  bind('reuse-player', addParticipant);
  bind('player', async fields => { await addParticipant(fields); await loadAccounts(); });
  bind('seeds', async fields => {
    if (!draft) return;
    const selected = [...fields].filter(([, value]) => value !== '');
    if (new Set(selected.map(([, value]) => value)).size !== selected.length) throw new Error('Jeder Setzplatz darf nur einmal vergeben werden.');
    const order = selected.sort((a, b) => Number(a[1]) - Number(b[1])).map(([id]) => id);
    draft = await post(`/${draft.id}/setzliste`, { order, version: draft.version });
    start.hidden = true;
    preview.replaceChildren();
    status.textContent = 'Setzliste gespeichert.';
  });
  bind('draw', async fields => {
    if (!draft) return;
    const groupCount = Number(fields.get('groupCount'));
    let groups: string[][] | undefined;
    if (manualToggle.checked) {
      groups = Array.from({ length: groupCount }, () => []);
      for (const entry of entries) {
        const group = Number(fields.get(`group-${entry.id}`));
        if (!Number.isInteger(group) || group < 1 || group > groupCount) throw new Error(`Gruppe für ${entry.display_name} auswählen.`);
        groups[group - 1].push(entry.id);
      }
    }
    const reason = String(fields.get('reason') ?? '');
    const result: { seed: number; entries: { id: string; display_name: string }[]; groups: string[][] } =
      await post(`/${draft.id}/auslosung/vorschau`, { groupCount, groups, reason, version: draft.version });
    suggested = { groupCount, seed: result.seed, groups, reason };
    const names = new Map(result.entries.map(entry => [entry.id, entry.display_name]));
    preview.replaceChildren(...result.groups.map((group, index) => {
      const item = document.createElement('li');
      item.textContent = `Gruppe ${String.fromCharCode(65 + index)} · ${group.map(id => names.get(id)).join(', ')}`;
      return item;
    }));
    start.hidden = false;
  });
  bind('start', async fields => {
    if (!draft || !suggested || !confirm('Diese Gruppenauslosung übernehmen und die Vorrunde starten?')) return;
    const id = draft.id;
    const saved = await post(`/${id}/auslosung/starten`, { ...suggested, version: draft.version, confirm: true,
      publish: fields.has('publish'), allowSubmissions: fields.has('allowSubmissions') });
    await openCompetition({ ...saved, id, title: document.querySelector('#draft-title')!.textContent ?? '', status: 'groups_active' });
    status.textContent = 'Vorrunde gestartet. Die Ergebnisse können jetzt eingetragen werden.';
    document.querySelector<HTMLElement>('#results-title')?.focus();
    await listCompetitions();
  });
  type PhasePreview = { bracket: BracketMatch[]; positions: string[][]; rankings: { id: string; name?: string }[][] };
  function showKnockout(bracket: BracketMatch[], names: Map<string, string>, config: { qualifiers: number; bronze: boolean }) {
    const opening = bracket.filter(match => match.round === 1);
    const slots = opening.flatMap(match => [match.home, match.away]);
    const choices = [...new Set(slots)];
    const editor = document.createElement('div');
    editor.className = 'grid gap-3';
    const intro = document.createElement('p');
    intro.className = 'text-sm';
    intro.textContent = 'Wähle einen anderen Eintrag, um zwei Plätze zu tauschen. Beim Start wird die angezeigte Aufstellung übernommen.';
    const reset = document.createElement('button');
    reset.type = 'button';
    reset.className = 'min-h-11 justify-self-start rounded-lg border border-[#173a2e] px-4 py-2 font-semibold';
    reset.textContent = 'Automatische Aufstellung wiederherstellen';
    editor.append(intro, reset);
    const note = document.createElement('p');
    note.setAttribute('role', 'status');
    note.className = 'text-sm text-red-800';
    const selects: HTMLSelectElement[] = [];
    async function update(next?: (string | null)[], focus?: number) {
      if (!draft) return;
      const id = draft.id;
      const startButton = phaseForm.querySelector<HTMLButtonElement>('button[value="start"]')!;
      const configFields = [...phaseForm.querySelectorAll<HTMLInputElement>('input[name="qualifiers"], input[name="bronze"]')];
      const previewButton = phaseForm.querySelector<HTMLButtonElement>('button[value="preview"]')!;
      startButton.disabled = true;
      previewButton.disabled = true;
      configFields.forEach(input => { input.disabled = true; });
      reset.disabled = true;
      selects.forEach(select => { select.disabled = true; });
      note.textContent = '';
      try {
        const result: PhasePreview = await post(`/${id}/folgephase/vorschau`, { version: draft.version, ...config, knockoutSlots: next });
        if (draft?.id !== id) return;
        knockoutSlots = next;
        showKnockout(result.bracket, names, config);
        if (focus !== undefined) knockoutPreview.querySelectorAll('select')[focus]?.focus();
      } catch (error) {
        for (const [index, select] of selects.entries()) select.value = slots[index] ?? '';
        note.textContent = error instanceof Error ? error.message : 'Die Aufstellung konnte nicht geändert werden.';
      } finally {
        startButton.disabled = false;
        previewButton.disabled = false;
        configFields.forEach(input => { input.disabled = false; });
        reset.disabled = false;
        selects.forEach(select => { select.disabled = false; });
      }
    }
    reset.onclick = () => void update();
    opening.forEach((match, index) => {
      const row = document.createElement('fieldset');
      row.className = 'grid grid-cols-2 gap-2 rounded-lg border border-[#d9dbd0] p-3';
      const title = document.createElement('legend');
      title.className = 'px-1 text-sm font-semibold';
      title.textContent = `${bracketRound(Math.max(...bracket.map(item => item.round)) - 1)} ${match.position}`;
      row.append(title);
      for (let side = 0; side < 2; side++) {
        const offset = index * 2 + side;
        const select = document.createElement('select');
        select.className = 'min-w-0 rounded-lg border border-[#9fa995] bg-white px-2 py-2 text-sm';
        select.setAttribute('aria-label', `${title.textContent}, Platz ${side + 1}`);
        select.replaceChildren(...choices.map(player => new Option(player ? names.get(player) ?? player : 'Freilos', player ?? '')));
        select.value = slots[offset] ?? '';
        select.onchange = () => {
          const next = [...slots];
          const selected = select.value || null;
          if (selected === next[offset]) return;
          const other = next.indexOf(selected);
          [next[offset], next[other]] = [next[other], next[offset]];
          void update(next, offset);
        };
        selects.push(select);
        row.append(select);
      }
      editor.append(row);
    });
    knockoutPreview.replaceChildren(renderBracket(bracket, names), editor, note);
  }
  phaseForm.addEventListener('change', event => {
    if (event.target instanceof HTMLInputElement && ['qualifiers', 'bronze'].includes(event.target.name)) {
      knockoutSlots = undefined;
      knockoutPreview.replaceChildren();
      document.querySelector('#phase-preview')!.textContent = '';
    }
  });
  bind('phase', async fields => {
    if (!draft) return;
    const action = fields.get('action');
    const endpoint = action === 'preview' ? 'folgephase/vorschau' : action === 'start' ? 'folgephase/starten' : 'abschliessen';
    if (action !== 'preview' && !confirm('Diese Turnierphase verbindlich ändern?')) return;
    const config = { qualifiers: Number(fields.get('qualifiers')), bronze: fields.has('bronze') };
    const response = await post(`/${draft.id}/${endpoint}`, { version: draft.version, ...config,
      knockoutSlots, confirm: action !== 'preview' });
    if (action === 'preview') {
      const groups = response.rankings.flat() as { id: string; name?: string }[];
      const names = new Map(groups.map(row => [row.id, row.name ?? row.id]));
      const rows = (response.positions as string[][]).map((players, index) => `Gruppe ${index + 1} · ${players.map(player => names.get(player)).join(', ')}`);
      document.querySelector('#phase-preview')!.textContent = rows.length ? rows.join('\n') : `${response.bracket.length} Begegnungen im K.-o.-Spielplan.`;
      if (response.bracket.length) showKnockout(response.bracket, names, config);
    } else {
      await openCompetition({ ...response, id: draft.id, title: document.querySelector('#draft-title')!.textContent ?? '',
        status: action === 'start' ? 'phase_active' : 'finished' });
      status.textContent = action === 'start' ? 'Folgephase gestartet.' : 'Meisterschaft abgeschlossen.';
      document.querySelector<HTMLElement>('#results-title')?.focus();
      await listCompetitions();
    }
  });
  bind('invite', async fields => {
    const response = await fetch('/api/meisterschaft-login/einladen', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: fields.get('email') }) });
    const output = await response.json();
    if (!response.ok) throw new Error(output.error ?? 'Einladung fehlgeschlagen.');
    status.textContent = 'Einladung verarbeitet.';
    await loadAccounts();
  });
  async function loadAccounts() {
    const response = await fetch('/api/meisterschaft-konten');
    if (!response.ok) return;
    const { accounts, players }: { accounts: { email: string; verified: number | null; active: number }[];
      players: Contact[] } = await response.json();
    contacts = players;
    renderAvailableContacts();
    document.querySelector('#accounts')!.replaceChildren(new Option('Bitte auswählen', ''), ...accounts.map(account =>
      new Option(`${account.email}${!account.verified ? ' · unbestätigt' : !account.active ? ' · gesperrt' : ''}`, account.email)));
    document.querySelector('#players')!.replaceChildren(new Option('Bitte auswählen', ''), ...players.filter(player => player.active).map(player =>
      new Option(player.display_name, player.id)));
    document.querySelector<HTMLElement>('#access')!.hidden = !accounts.length;
  }
  bind('access', async fields => {
    const action = fields.get('action');
    const email = fields.get('email');
    const payload = action === 'link' ? { action, email, playerId: fields.get('playerId'), canSubmit: fields.has('canSubmit') } :
      { action: 'account', email, active: action === 'enable' };
    if (action === 'disable' && !confirm('Konto sperren und aktive Anmeldungen widerrufen?')) return;
    const response = await fetch('/api/meisterschaft-konten', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload) });
    const output = await response.json();
    if (!response.ok) throw new Error(output.error ?? 'Speichern fehlgeschlagen.');
    status.textContent = 'Konto aktualisiert.';
    await loadAccounts();
  });
  listCompetitions().catch(() => {});
  loadAccounts().catch(() => {});
</script>
