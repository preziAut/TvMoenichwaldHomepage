---
import '../styles/global.css';
import {site,navigation} from '../config';
interface Props {title:string;description?:string;}
const {title,description='Tennis, Gemeinschaft und Vereinsleben in Mönichwald. Termine, Bilder und Platzreservierung beim TV Mönichwald.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url);
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · TV Mönichwald</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#213b30"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{import.meta.env.PUBLIC_SITE_APPROVED!=='true'&&<meta name="robots" content="noindex,nofollow"/>}</head>
<body><a class="skip" href="#inhalt">Zum Inhalt</a><div class="topbar"><div class="wrap">Tennis in der Oststeiermark <span>Seit 1978 am Platz.</span></div></div><header><div class="wrap header-inner"><a href="/" class="brand" aria-label="TV Mönichwald – Startseite"><img class="brand-logo" src="/media/cc04f5358a4d3f-640.webp" alt="" width="58" height="58"/><span>TV MÖNICHWALD<small>TENNIS · GEMEINSCHAFT · ZUHAUSE</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menü ☰</button><nav id="navigation" aria-label="Hauptnavigation">{navigation.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}<a class="button small" href="/reservierung/">Platz reservieren ↗</a></nav></div></header><main id="inhalt"><slot/></main><footer><div class="wrap footer-grid"><div><a class="footer-brand" href="/">TV MÖNICHWALD<span>Ein Verein. Viele gemeinsame Momente.</span></a><p>Tennis in Mönichwald, Oststeiermark.</p></div><div><h2>Am Platz</h2><a href="/reservierung/">Platz reservieren ↗</a><a href="/mitgliedschaft/">Mitglied werden</a><a href="/webcam/">Webcam</a></div><div><h2>Im Verein</h2><a href="/verein/">Unsere Geschichte</a><a href="/wechsellandcup/">Wechsellandcup</a><a href={site.facebook} rel="noopener noreferrer">Facebook ↗</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Tennisverein Mönichwald</span><div><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a><a href="/kontakt/">Kontakt</a></div></div></footer>
<script>const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));document.querySelector('nav')?.classList.toggle('open',open);});</script>
</body></html>
