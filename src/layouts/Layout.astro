---
import '../styles/global.css';
import { site } from '../config';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Tennis, Gemeinschaft und Vereinsleben in Mönichwald. Termine, Bilder und Platzreservierung beim TV Mönichwald.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const container = 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8';
const link = 'text-stone-700 hover:text-orange-800';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · TV Mönichwald</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&amp;display=swap" />
    {import.meta.env.PUBLIC_SITE_APPROVED !== 'true' && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50! font-['Plus_Jakarta_Sans',system-ui,sans-serif]! text-slate-900!">
    <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3 focus:text-indigo-700" href="#inhalt">Zum Inhalt</a>

    <slot name="header"><Navbar /></slot>

    <main id="inhalt" class="grow">
      <slot name="main"><slot /></slot>
    </main>

    <slot name="footer">
      <footer class="border-t border-slate-200 bg-stone-50! py-14! text-emerald-950!">
        <div class:list={[container, 'grid grid-cols-2 gap-8 md:grid-cols-[1.5fr_1fr_1fr]']}>
          <div class="col-span-2 md:col-span-1">
            <a class="text-lg font-extrabold text-emerald-950 hover:text-orange-800" href="/">TV Mönichwald</a>
            <p class="mt-2 text-sm text-slate-600">Tennis in Mönichwald, Oststeiermark.</p>
          </div>
          <div class="grid content-start gap-3 text-sm">
            <h2 class="font-semibold">Am Platz</h2>
            <a class={link} href="/reservierung/">Platz reservieren</a>
            <a class={link} href="/mitgliedschaft/">Mitglied werden</a>
            <a class={link} href="/webcam/">Webcam</a>
          </div>
          <div class="grid content-start gap-3 text-sm">
            <h2 class="font-semibold">Im Verein</h2>
            <a class={link} href="/verein/">Unsere Geschichte</a>
            <a class={link} href="/bilder/">Bilder &amp; Galerien</a>
            <a class={link} href="/ergebnisse/">Ergebnisarchiv</a>
            <a class={link} href="/wechsellandcup/">Wechsellandcup</a>
            <a class={link} href={site.facebook} rel="noopener noreferrer">Facebook ↗</a>
          </div>
          <div class="col-span-full flex flex-wrap justify-between gap-4 border-t border-slate-200 pt-5 text-xs text-slate-600">
            <span>© {new Date().getFullYear()} Tennisverein Mönichwald</span>
            <div class="flex flex-wrap gap-4">
              <a class={link} href="/impressum/">Impressum</a>
              <a class={link} href="/datenschutz/">Datenschutz</a>
              <a class={link} href="/kontakt/">Kontakt</a>
            </div>
          </div>
        </div>
      </footer>
    </slot>
  </body>
</html>
