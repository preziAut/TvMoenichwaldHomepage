# Build-time values; no secrets in PUBLIC_ variables.
PUBLIC_SITE_APPROVED=false
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_WEBCAM_URL=
# Runtime secrets in Cloudflare Pages Settings, never in Git:
# RESEND_API_KEY, TURNSTILE_SECRET_KEY, CONTACT_FROM, CONTACT_TO
# Runtime settings: WALDBACH_URL, WEBCAM_URL
# Booking runtime settings (legacy by default): BOOKING_MOENICHWALD_MODE, BOOKING_WALDBACH_MODE
# Separate Hyperdrive bindings: BOOKING_PILOT_DB and BOOKING_DB
# Set the build variable BOOKING_PAGES_POSTGRES=true after enabling Node compatibility and Hyperdrive.
