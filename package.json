{
  "name": "tv-moenichwald",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/redirect-data.mjs && node scripts/astro.mjs build && npm --prefix booking ci --ignore-scripts && node booking/tools/build-demo.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "test": "node scripts/redirect-data.mjs && node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/sitemap": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "7.4.12",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "cheerio": "latest",
    "node": "^24.22.3",
    "sanitize-html": "latest",
    "sharp": "latest",
    "turndown": "latest",
    "typescript": "latest"
  }
}
